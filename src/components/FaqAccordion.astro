---
// src/components/FaqAccordion.astro
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  items: FaqItem[];
}

const { title = "Veelgestelde vragen", items } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section class="faq-section" aria-labelledby="faq-title">
  <h2 id="faq-title" class="faq-title">{title}</h2>
  <div class="faq-list">
    {items.map((item, index) => (
      <details class="faq-item" id={`faq-${index}`}>
        <summary class="faq-question">
          <span>{item.question}</span>
          <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-section {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .faq-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .faq-item[open] {
    border-color: var(--border-strong);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    list-style: none;
    user-select: none;
    overflow-wrap: break-word;
    word-break: break-word;
    gap: 0.75rem;
  }

  .faq-question span {
    flex: 1 1 auto;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: var(--text-subtle);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem 1.25rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    overflow-wrap: break-word;
    word-break: break-word;
  }
</style>
