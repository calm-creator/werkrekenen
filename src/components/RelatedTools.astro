---
// src/components/RelatedTools.astro
import type { CalculatorMeta } from '../data/calculators';

export interface Props {
  tools: CalculatorMeta[];
}

const { tools } = Astro.props;
if (!tools || tools.length === 0) return null;
---

<section class="related-tools-section" aria-labelledby="related-tools-title">
  <h2 id="related-tools-title" class="related-tools-heading">Gerelateerde berekeningen</h2>
  <div class="related-tools-grid">
    {tools.map((tool) => (
      <a href={`/${tool.slug}/`} class="related-tool-card">
        <div class="related-tool-header">
          <span class="related-tool-category">{tool.categoryTitle}</span>
          <svg class="related-tool-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
        <h3 class="related-tool-title">{tool.title}</h3>
        <p class="related-tool-desc">{tool.description}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .related-tools-section {
    margin-top: 3rem;
    margin-bottom: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .related-tools-heading {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .related-tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .related-tools-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }

  .related-tool-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.15s ease;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .related-tool-card:hover {
    border-color: var(--color-primary-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
  }

  .related-tool-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    width: 100%;
    max-width: 100%;
  }

  .related-tool-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .related-tool-arrow {
    color: var(--text-subtle);
    transition: transform 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .related-tool-card:hover .related-tool-arrow {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  .related-tool-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 0.375rem;
    line-height: 1.3;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .related-tool-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }
</style>
