---
// src/components/calculators/VakantiegeldCalculator.astro
import { DUTCH_RATES } from '../../data/dutchRates';
---

<div class="calc-grid" id="vakantiegeld-calc">
  <!-- Invoerkaart -->
  <div class="calc-card">
    <h2 class="calc-section-title">Salaris & opbouw invoeren</h2>

    <!-- Bruto maandsalaris -->
    <div class="form-group">
      <label for="input-v-salary" class="form-label">Bruto maandsalaris</label>
      <div class="input-wrapper">
        <span class="input-prefix">€</span>
        <input
          type="number"
          id="input-v-salary"
          class="form-input input-has-prefix"
          value="3500"
          min="0"
          step="50"
        />
      </div>
      <span class="form-hint">Je vaste bruto maandsalaris zonder toeslagen.</span>
    </div>

    <!-- Aantal gewerkte maanden -->
    <div class="form-group">
      <label for="input-v-months" class="form-label">Aantal maanden opbouw in het lopende jaar</label>
      <div class="input-wrapper">
        <input
          type="number"
          id="input-v-months"
          class="form-input input-has-suffix"
          value="12"
          min="1"
          max="12"
          step="1"
        />
        <span class="input-suffix">maanden</span>
      </div>
      <span class="form-hint">
        Het opbouwjaar loopt doorgaans van 1 juni tot en met 31 mei (12 maanden bij een volledig werkjaar).
      </span>
    </div>

    <!-- Percentage vakantiegeld -->
    <div class="form-group">
      <div class="form-label-row">
        <label for="input-v-percent" class="form-label">Percentage vakantiebijslag</label>
        <span class="rate-status-tag">Wettelijk minimum 8%</span>
      </div>
      <div class="input-wrapper">
        <input
          type="number"
          id="input-v-percent"
          class="form-input input-has-suffix"
          value={DUTCH_RATES.vacationPayPercentage}
          min="8"
          max="15"
          step="0.5"
        />
        <span class="input-suffix">%</span>
      </div>
      <span class="form-hint">Volgens de wet (WML) minimaal 8%. Sommige CAO's bieden een hoger percentage.</span>
    </div>

    <!-- Vaste maandelijkse toeslagen -->
    <div class="form-group">
      <label for="input-v-extras" class="form-label">Vaste maandelijkse toeslagen (optioneel)</label>
      <div class="input-wrapper">
        <span class="input-prefix">€</span>
        <input
          type="number"
          id="input-v-extras"
          class="form-input input-has-prefix"
          value="0"
          min="0"
          step="25"
        />
      </div>
      <span class="form-hint">Bijv. vaste ploegentoeslag of onregelmatigheidstoeslag waarover vakantiegeld wordt opgebouwd.</span>
    </div>

    <div class="form-actions">
      <button type="button" id="btn-reset-vakantiegeld" class="btn btn-secondary btn-sm">
        Herstellen naar standaard
      </button>
    </div>
  </div>

  <!-- Resultatenkaart -->
  <div class="calc-result-card" aria-live="polite">
    <div class="result-hero">
      <span class="result-hero-label">Bruto vakantiegeld (mei)</span>
      <div class="result-hero-value" id="res-gross-vacation">€ 3.360,00</div>
      <span class="result-hero-sub" id="res-vacation-sub">8% over 12 maanden opbouw</span>
    </div>

    <div class="result-breakdown">
      <div class="result-row">
        <span class="result-row-label">Bruto opbouw per maand</span>
        <span class="result-row-value" id="res-monthly-accrual">€ 280,00</span>
      </div>
      <div class="result-row">
        <span class="result-row-label">Totale grondslag</span>
        <span class="result-row-value" id="res-total-basis">€ 42.000,00</span>
      </div>
      <div class="result-row">
        <span class="result-row-label">Geschatte netto indicatie</span>
        <span class="result-row-value" style="color: var(--color-success);" id="res-net-indicative">~ € 1.747,20</span>
      </div>
    </div>

    <div class="callout callout-info" style="margin-top: 1.25rem; font-size: 0.8125rem; padding: 0.75rem;">
      <strong>Belasting op vakantiegeld:</strong> Vakantiegeld wordt belast volgens het <em>bijzonder tarief</em> voor loonheffing (vaak tussen 37% en 49,5% plus eventueel verrekende heffingskortingen). Hierdoor hou je netto meestal circa de helft tot 55% over.
    </div>
  </div>
</div>

<style>
  .calc-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .rate-status-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-success);
  }

  .form-actions {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: flex-end;
  }
</style>

<script is:inline>
  (() => {
    const calc = document.getElementById('vakantiegeld-calc');
    if (!calc) return;

    const inputSalary = calc.querySelector('#input-v-salary');
    const inputMonths = calc.querySelector('#input-v-months');
    const inputPercent = calc.querySelector('#input-v-percent');
    const inputExtras = calc.querySelector('#input-v-extras');
    const btnReset = calc.querySelector('#btn-reset-vakantiegeld');

    const resGross = calc.querySelector('#res-gross-vacation');
    const resSub = calc.querySelector('#res-vacation-sub');
    const resMonthlyAccrual = calc.querySelector('#res-monthly-accrual');
    const resTotalBasis = calc.querySelector('#res-total-basis');
    const resNetIndicative = calc.querySelector('#res-net-indicative');

    const formatCurrency = (val) => new Intl.NumberFormat('nl-NL', { style: 'currency', currency: 'EUR' }).format(val);

    function calculate() {
      const salary = Math.max(0, parseFloat(inputSalary.value) || 0);
      const months = Math.min(12, Math.max(0, parseFloat(inputMonths.value) || 0));
      const percent = Math.max(0, parseFloat(inputPercent.value) || 8);
      const extras = Math.max(0, parseFloat(inputExtras.value) || 0);

      const monthlyBasis = salary + extras;
      const totalBasis = monthlyBasis * months;
      const grossVacation = (totalBasis * percent) / 100;
      const monthlyAccrual = (monthlyBasis * percent) / 100;
      const netIndicative = grossVacation * 0.52; // indicatie gemiddelde inhouding bijzonder tarief

      resGross.textContent = formatCurrency(grossVacation);
      resSub.textContent = `${percent}% over ${months} ${months === 1 ? 'maand' : 'maanden'} opbouw`;
      resMonthlyAccrual.textContent = formatCurrency(monthlyAccrual);
      resTotalBasis.textContent = formatCurrency(totalBasis);
      resNetIndicative.textContent = `~ ${formatCurrency(netIndicative)}`;
    }

    inputSalary.addEventListener('input', calculate);
    inputMonths.addEventListener('input', calculate);
    inputPercent.addEventListener('input', calculate);
    inputExtras.addEventListener('input', calculate);

    btnReset.addEventListener('click', () => {
      inputSalary.value = '3500';
      inputMonths.value = '12';
      inputPercent.value = '8';
      inputExtras.value = '0';
      calculate();
    });

    calculate();
  })();
</script>
