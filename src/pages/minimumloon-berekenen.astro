          </tr>
          <tr>
            <td><strong>15 t/m 17 jaar</strong></td>
            <td>Gelijk aan regulier</td>
            <td>€ 4,41 – € 5,81</td>
            <td>€ 4,50 – € 5,92</td>
          </tr>
