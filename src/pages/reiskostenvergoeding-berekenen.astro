---
// src/pages/reiskostenvergoeding-berekenen.astro
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import ReiskostenCalculator from '../components/calculators/ReiskostenCalculator.astro';
import { getCalculatorBySlug } from '../data/calculators';
import { DUTCH_RATES } from '../data/dutchRates';

const meta = getCalculatorBySlug('reiskostenvergoeding-berekenen')!;

const faqItems = [
  {
    question: 'Wat is de maximale onbelaste reiskostenvergoeding in Nederland?',
    answer: `De maximale fiscaal onbelaste kilometervergoeding voor woon-werkverkeer en zakelijke reizen is vastgesteld op € ${DUTCH_RATES.travelAllowancePerKm.toFixed(2).replace('.', ',')} per kilometer door de Belastingdienst. Dit tarief geldt ongeacht of je met de auto, motor, scooter of fiets reist.`
  },
  {
    question: 'Hoe werkt de 214-dagenregeling van de Belastingdienst?',
    answer: 'Als je minimaal 128 dagen per jaar naar een vaste werkplek reist (bij een 5-daagse werkweek), mag je werkgever een vaste maandelijkse vergoeding uitkeren op basis van 214 reisdagen per jaar. Bij een parttime werkweek wordt dit aantal evenredig verminderd: bij 4 dagen reis je 171,2 dagen per jaar, bij 3 dagen 128,4 dagen, enzovoort.'
  },
  {
    question: 'Mag een werkgever meer vergoeden dan € 0,23 per kilometer?',
    answer: 'Ja, een werkgever mag contractueel meer vergoeden, bijvoorbeeld € 0,29 of € 0,35 per km. Alles boven het wettelijke bedrag van € 0,23 per km wordt door de Belastingdienst echter beschouwd als belast loon, waarover loonheffing en premies moeten worden afgedragen.'
  },
  {
    question: 'Geldt de kilometervergoeding ook voor reizen met de fiets?',
    answer: 'Ja, de onbelaste vergoeding van € 0,23 per kilometer geldt voor alle vervoermiddelen van de werknemer, inclusief de fiets of e-bike, en zelfs wanneer je te voet naar het werk gaat.'
  },
  {
    question: 'Kan ik op dezelfde dag reiskosten en thuiswerkvergoeding krijgen?',
    answer: 'Nee. Volgens de fiscale regels van de Belastingdienst mag je voor dezelfde werkdag niet tegelijkertijd een onbelaste thuiswerkvergoeding én een onbelaste reiskostenvergoeding voor woon-werkverkeer ontvangen.'
  }
];
---

<CalculatorLayout
  calculator={meta}
  faqItems={faqItems}
  applicableYear={2026}
  officialSource="Belastingdienst"
>
  <ReiskostenCalculator slot="calculator" />

  <div slot="explanation">
    <h2>Wat is de reiskostenvergoeding voor woon-werkverkeer?</h2>
    <p>
      In Nederland mogen werkgevers werknemers een onbelaste kilometervergoeding uitkeren voor de afstand tussen het woonadres en de vaste standplaats of werklocatie. Deze vergoeding dekt onder andere brandstof, slijtage, afschrijving en verzekering van het eigen vervoermiddel.
    </p>

    <h3>De norm van de Belastingdienst (€ 0,23 per km)</h3>
    <p>
      Sinds 2024 en gehandhaafd in 2025/2026 bedraagt de wettelijke onbelaste norm <strong>€ 0,23 per kilometer</strong>. Over dit bedrag hoef je geen loonbelasting en premies volksverzekeringen te betalen: het bedrag dat berekend wordt, is dus volledig netto.
    </p>

    <div class="callout callout-info">
      <strong>Vaste vergoeding via de 214-dagenregeling:</strong><br />
      Om te voorkomen dat je elke afzonderlijke reisdag met bonnetjes of rittenstaten moet declareren, staat de Belastingdienst toe dat een vaste maandelijkse vergoeding wordt berekend op basis van <strong>214 werkdagen per jaar</strong> (bij fulltime 5 reisdagen per week).
    </div>

    <h3>Overzicht aantal reisdagen bij parttime werken</h3>
    <table>
      <thead>
        <tr>
          <th>Reisdagen per week</th>
          <th>Fiscale reisdagen per jaar</th>
          <th>Rekenformule per maand</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>1 reisdag</strong></td>
          <td>42,8 dagen / jaar</td>
          <td>(Dagbedrag × 42,8) ÷ 12</td>
        </tr>
        <tr>
          <td><strong>2 reisdagen</strong></td>
          <td>85,6 dagen / jaar</td>
          <td>(Dagbedrag × 85,6) ÷ 12</td>
        </tr>
        <tr>
          <td><strong>3 reisdagen</strong></td>
          <td>128,4 dagen / jaar</td>
          <td>(Dagbedrag × 128,4) ÷ 12</td>
        </tr>
        <tr>
          <td><strong>4 reisdagen</strong></td>
          <td>171,2 dagen / jaar</td>
          <td>(Dagbedrag × 171,2) ÷ 12</td>
        </tr>
        <tr>
          <td><strong>5 reisdagen</strong></td>
          <td>214,0 dagen / jaar</td>
          <td>(Dagbedrag × 214) ÷ 12</td>
        </tr>
      </tbody>
    </table>

    <h2>Rekenvoorbeeld reiskostenvergoeding</h2>
    <p>
      Stel: je woont op <strong>30 kilometer</strong> afstand van je kantoor en je reist <strong>3 dagen per week</strong> naar je werklocatie:
    </p>
    <ul>
      <li><strong>Totale afstand per dag:</strong> 30 km heen + 30 km terug = 60 kilometer retour.</li>
      <li><strong>Dagvergoeding onbelast:</strong> 60 km × € 0,23 = <strong>€ 13,80 per reisdag</strong>.</li>
      <li><strong>Weekvergoeding:</strong> € 13,80 × 3 reisdagen = <strong>€ 41,40 per week</strong>.</li>
      <li><strong>Jaarvergoeding (214-norm pro rata):</strong> € 13,80 × 128,4 dagen = <strong>€ 1.771,92 per jaar</strong>.</li>
      <li><strong>Vaste maandelijkse netto uitkering:</strong> € 1.771,92 ÷ 12 = <strong>€ 147,66 netto per maand</strong>.</li>
    </ul>

    <h2>Is een werkgever verplicht reiskosten te vergoeden?</h2>
    <p>
      In de Nederlandse wet staat geen algemene verplichting voor werkgevers om reiskosten te vergoeden. Echter, in de overgrote meerderheid van Nederlandse cao's en individuele arbeidsovereenkomsten zijn hier bindende afspraken over vastgelegd. Controleer hiervoor altijd je eigen personeelshandboek of CAO.
    </p>
  </div>
</CalculatorLayout>
