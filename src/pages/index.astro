---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion, { type FaqItem } from '../components/FaqAccordion.astro';
import { CALCULATORS, CATEGORIES, getCalculatorBySlug, type CalculatorMeta } from '../data/calculators';
import { DUTCH_RATES } from '../data/dutchRates';

// Veelgebruikte rekentools: precies 6 relevante en populaire bestaande calculators
const POPULAR_SLUGS = [
  'netto-salaris-berekenen',
  'uurloon-berekenen',
  'vakantiegeld-berekenen',
  'reiskostenvergoeding-berekenen',
  'jaarinkomen-berekenen',
  'transitievergoeding-berekenen'
];

const popularTools = POPULAR_SLUGS
  .map(slug => getCalculatorBySlug(slug))
  .filter((c): c is CalculatorMeta => Boolean(c));

const categories = Object.values(CATEGORIES);

const toolCountByCategory: Record<string, number> = {
  salaris: CALCULATORS.filter(c => c.category === 'salaris').length,
  werkuren: CALCULATORS.filter(c => c.category === 'werkuren').length,
  vergoedingen: CALCULATORS.filter(c => c.category === 'vergoedingen').length,
};

const categoryHighlights: Record<string, string[]> = {
  salaris: ['Netto salaris', 'Uurloon', 'Vakantiegeld', '13e Maand'],
  werkuren: ['Vakantiedagen', 'FTE', 'Opzegtermijn', 'Werkdagen'],
  vergoedingen: ['Reiskosten', 'Thuiswerkvergoeding', 'Kilometervergoeding']
};

// Exact 10 feitelijke, geruststellende en betrouwbare FAQs in natuurlijk Nederlands
const homepageFaq: FaqItem[] = [
  {
    question: 'Wat is WerkRekenen.com en voor wie is het bedoeld?',
    answer: 'WerkRekenen.com is een onafhankelijk Nederlands rekenplatform met gespecialiseerde rekentools voor werknemers, werkgevers, zzp\'ers en HR-professionals. Het platform biedt directe en begrijpelijke berekeningen voor salaris, werkuren, vakantiegeld, overwerk, ontslagvergoedingen en onbelaste reiskosten.'
  },
  {
    question: 'Zijn de berekeningen gebaseerd op de actuele Nederlandse wetgeving in 2026?',
    answer: `Ja. Al onze rekenmodules hanteren de officiële wetgeving, fiscale tabellen en richtlijnen voor ${DUTCH_RATES.year} van de Belastingdienst, het Ministerie van Sociale Zaken en Werkgelegenheid (SZW), UWV en het CBS. Dit omvat onder meer het actuele wettelijk minimumloon, de box 1-belastingschijven, heffingskortingen, de maximale transitievergoeding en onbelaste kilometervergoedingen.`
  },
  {
    question: 'Hoe nauwkeurig zijn de uitkomsten van de rekentools?',
    answer: 'De uitkomsten zijn zeer nauwkeurig en volgen exact de wettelijk vastgestelde rekenregels en afrondingsnormen. Omdat een uiteindelijke loonstrook echter mede afhankelijk kan zijn van bedrijfsspecifieke CAO-afspraken, pensioenpremies of individuele arbeidsvoorwaarden, gelden de uitkomsten als een betrouwbare en zorgvuldig berekende indicatie.'
  },
  {
    question: 'Zijn de berekeningen op WerkRekenen juridisch of fiscaal bindend?',
    answer: 'Nee. Onze berekeningen zijn indicatief en bedoeld ter informatie, vergelijking en voorbereiding op loongesprekken of contractonderhandelingen. Ze vervangen geen officiële loonstrook of bindend juridisch of fiscaal advies. Voor definitieve besluiten adviseren we altijd je werkgever, CAO of een erkend financieel adviseur te raadplegen.'
  },
  {
    question: 'Worden mijn ingevoerde salaris- en persoonsgegevens opgeslagen?',
    answer: 'Nee, absoluut niet. Jouw privacy is volledig gewaarborgd. Alle berekeningen worden voor 100% lokaal in je eigen webbrowser uitgevoerd. Er worden geen salarisbedragen, contracturen of persoonsgegevens naar externe servers verstuurd of opgeslagen in databases.'
  },
  {
    question: 'Hoe worden de resultaten en bedragen precies berekend?',
    answer: 'Elke calculator maakt gebruik van transparante formules die direct aansluiten op de betreffende Nederlandse wetgeving (zoals art. 7:634 BW voor vakantiedagen, de WAB voor de transitievergoeding en de Wet minimumloon voor vakantiebijslag). Op elke toolpagina vind je een gedetailleerde toelichting op de gebruikte formules en rekenvoorbeelden.'
  },
  {
    question: 'Kost het gebruik van de rekenmodules geld of heb ik een account nodig?',
    answer: 'Nee. WerkRekenen.com is volledig kosteloos en vrij toegankelijk. Je hoeft geen account aan te maken, geen abonnement af te sluiten en geen e-mailadres achter te laten. Je kunt direct en onbeperkt gebruikmaken van alle beschikbare rekentools.'
  },
  {
    question: 'Waarom kan mijn salarisstrook afwijken van de berekende bedragen?',
    answer: 'Afwijkingen tussen een online berekening en je loonstrook ontstaan vrijwel altijd door specifieke bedrijfskenmerken. Denk aan de hoogte van de werknemerspremie voor het bedrijfspensioenfonds, inhoudingen voor een WGA-hiaatverzekering, een leaseauto met fiscale bijtelling, of afwijkende overwerktoeslagen binnen jouw sector-CAO.'
  },
  {
    question: 'Hoe vaak worden de berekeningen en tarieven bijgewerkt?',
    answer: 'Onze rekenmodellen worden continu gemonitord en direct geactualiseerd zodra er officiële wijzigingen zijn. Dit gebeurt structureel per 1 januari (nieuwe belastingtarieven en heffingskortingen) en per 1 juli (halfjaarlijkse aanpassing van het wettelijk minimumloon), evenals bij tussentijdse beleidswijzigingen vanuit de overheid.'
  },
  {
    question: 'Werkt WerkRekenen ook snel en soepel op smartphones en tablets?',
    answer: 'Ja. WerkRekenen.com is ontworpen volgens een streng mobile-first principe zonder zware externe scripts of vertragende pop-ups. De invoervelden, keuzeknoppen en resultaten schalen soepel mee en laden razendsnel op elk formaat smartphone, tablet of computer.'
  }
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "WerkRekenen.com",
  "url": "https://werkrekenen.com/",
  "description": "Betrouwbare Nederlandse berekeningen voor werk, salaris, uren en vergoedingen",
  "inLanguage": "nl-NL"
};
---

<BaseLayout
  title="Werk en salaris eenvoudig berekenen | WerkRekenen.com"
  description="Bereken eenvoudig en snel je netto salaris, uurloon, vakantiegeld, reiskostenvergoeding en transitievergoeding volgens actuele Nederlandse normen voor 2026."
  schema={websiteSchema}
>
  <!-- Hero Sectie -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-badge">
        <span class="badge badge-success">Actueel {DUTCH_RATES.year}</span>
        <span class="hero-badge-text">Nederlandse normen & wetgeving</span>
      </div>
      <h1 class="hero-title">Werk en salaris <span class="hero-highlight">helder en eenvoudig</span> berekenen</h1>
      <p class="hero-subtitle">
        Direct inzicht in je netto salaris, uurloon, vakantiegeld, kilometervergoeding en transitievergoeding. Snel, 100% privé in je browser en afgestemd op de Nederlandse regels in {DUTCH_RATES.year}.
      </p>
      <div class="hero-actions">
        <a href="#populair" class="btn btn-primary">Bekijk veelgebruikte rekentools</a>
        <a href="/alle-berekeningen/" class="btn btn-secondary">Alle {CALCULATORS.length} rekentools</a>
      </div>

      <!-- Micro-Trust Bar -->
      <div class="hero-trust-bar">
        <div class="hero-trust-item">
          <svg class="trust-check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Geen account nodig</span>
        </div>
        <div class="hero-trust-item">
          <svg class="trust-check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>100% Privé in je browser</span>
        </div>
        <div class="hero-trust-item">
          <svg class="trust-check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Direct realtime resultaat</span>
        </div>
        <div class="hero-trust-item">
          <svg class="trust-check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Wettelijke normen {DUTCH_RATES.year}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Populaire Calculators Sectie (Precies 6) -->
  <section id="populair" class="container section-popular">
    <div class="section-header">
      <div>
        <h2 class="section-title">Veelgebruikte rekentools</h2>
        <p class="section-subtitle">De 6 meest geraadpleegde berekeningen voor loon, vergoedingen en arbeidsvoorwaarden.</p>
      </div>
      <a href="/alle-berekeningen/" class="section-link-more">Alle {CALCULATORS.length} rekentools bekijken &rarr;</a>
    </div>

    <div class="popular-grid">
      {popularTools.map((tool) => (
        <a href={`/${tool.slug}/`} class="popular-card">
          <div class="popular-card-top">
            <span class="popular-category">{tool.categoryTitle}</span>
            <span class="popular-badge-pill">Populair</span>
          </div>
          <h3 class="popular-card-title">{tool.title}</h3>
          <p class="popular-card-desc">{tool.description}</p>
          <div class="popular-card-action">
            <span class="popular-card-btn">Direct berekenen</span>
            <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- Extra navigatie-aansporing onder populaire tools -->
    <div class="popular-footer-cta">
      <div class="popular-footer-content">
        <h3 class="popular-footer-title">Zoek je een andere berekening?</h3>
        <p class="popular-footer-text">
          Van parttime salaris en 13e maand tot FTE, overuren en opzegtermijn: ontdek al onze gespecialiseerde Nederlandse calculators.
        </p>
      </div>
      <a href="/alle-berekeningen/" class="btn btn-secondary">Bekijk alle {CALCULATORS.length} rekentools &rarr;</a>
    </div>
  </section>

  <!-- In 3 Stappen Duidelijkheid -->
  <section class="container section-how">
    <div class="section-header text-center-header">
      <h2 class="section-title">Hoe werkt WerkRekenen?</h2>
      <p class="section-subtitle">Binnen enkele seconden een helder en betrouwbaar antwoord op jouw werkgerelateerde berekening.</p>
    </div>

    <div class="how-grid">
      <div class="how-card">
        <div class="how-step-num">1</div>
        <h3 class="how-step-title">Kies je onderwerp</h3>
        <p class="how-step-desc">Selecteer de gewenste calculator voor jouw salaris, uren, kilometervergoeding of ontslagregeling.</p>
      </div>
      <div class="how-card">
        <div class="how-step-num">2</div>
        <h3 class="how-step-title">Vul je gegevens in</h3>
        <p class="how-step-desc">Voer eenvoudig je bruto salaris, contracturen of reisafstand in. De tool rekent realtime en foutloos mee.</p>
      </div>
      <div class="how-card">
        <div class="how-step-num">3</div>
        <h3 class="how-step-title">Krijg direct inzicht</h3>
        <p class="how-step-desc">Bekijk direct een overzichtelijke specificatie met duidelijke toelichting, wettelijke grondslagen en handige vergelijkingen.</p>
      </div>
    </div>
  </section>

  <!-- Categorieën Sectie -->
  <section class="container section-categories">
    <div class="section-header">
      <div>
        <h2 class="section-title">Berekenen per categorie</h2>
        <p class="section-subtitle">Vind eenvoudig de juiste rekentool binnen onze drie overzichtelijke hoofdcategorieën.</p>
      </div>
    </div>

    <div class="categories-grid">
      {categories.map((cat) => (
        <a href={cat.slug} class="category-card">
          <div class="category-card-top">
            <span class="category-count-badge">{toolCountByCategory[cat.id] || 0} rekentools</span>
          </div>
          <h3 class="category-card-title">{cat.title}</h3>
          <p class="category-card-desc">{cat.description}</p>
          {categoryHighlights[cat.id] && (
            <div class="category-pills">
              {categoryHighlights[cat.id].map(tag => (
                <span class="category-pill">{tag}</span>
              ))}
            </div>
          )}
          <span class="category-card-link">Bekijk categorie &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Waarom WerkRekenen? (Trust & Transparency) -->
  <section class="container section-trust">
    <div class="trust-container">
      <div class="trust-header">
        <h2 class="trust-title">Waarom rekenen met WerkRekenen?</h2>
        <p class="trust-intro">
          Wij maken complexe Nederlandse loon- en arbeidsregels begrijpelijk, transparant en direct toepasbaar voor iedereen.
        </p>
      </div>

      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="trust-item-title">Officiële Nederlandse wetgeving</h3>
          <p class="trust-item-desc">
            Geen vage aannames. Onze rekenmodules zijn strikt afgestemd op de actuele richtlijnen van de Belastingdienst, het UWV en het Ministerie van SZW voor {DUTCH_RATES.year}.
          </p>
        </div>

        <div class="trust-item">
          <div class="trust-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3 class="trust-item-title">Direct en transparant resultaat</h3>
          <p class="trust-item-desc">
            Zodra je een getal aanpast, zie je realtime het resultaat. Inclusief complete specificatie en toelichting op de berekening, zodat je precies ziet waar elk getal vandaan komt.
          </p>
        </div>

        <div class="trust-item">
          <div class="trust-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h3 class="trust-item-title">100% Privacy & Lokale verwerking</h3>
          <p class="trust-item-desc">
            Al je invoer blijft uitsluitend in je eigen browser. Er worden nooit persoonlijke salarissen, uren, contractdata of financiële gegevens verstuurd of opgeslagen.
          </p>
        </div>

        <div class="trust-item">
          <div class="trust-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
              <line x1="9" y1="9" x2="9.01" y2="9"/>
              <line x1="15" y1="9" x2="15.01" y2="9"/>
            </svg>
          </div>
          <h3 class="trust-item-title">Volledig gratis & onafhankelijk</h3>
          <p class="trust-item-desc">
            Geen accounts, geen verplichte abonnementen en geen verborgen kosten. Een onafhankelijk en objectief hulpmiddel voor werknemers, zzp'ers en werkgevers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Homepage FAQ (Precies 10 FAQs) -->
  <section class="container section-faq">
    <div class="container-narrow">
      <FaqAccordion
        title="Veelgestelde vragen over WerkRekenen"
        items={homepageFaq}
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .hero-inner {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .hero-badge-text {
    color: var(--text-muted);
    font-weight: 500;
  }

  .hero-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.125rem;
    }
  }

  .hero-highlight {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    margin-bottom: 2rem;
  }

  /* Micro-Trust Bar */
  .hero-trust-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
    max-width: 680px;
    margin: 0 auto;
  }

  .hero-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .trust-check-icon {
    color: var(--color-success);
    flex-shrink: 0;
  }

  /* Section Header */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .text-center-header {
    text-align: center;
    justify-content: center;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
    line-height: 1.5;
  }

  .section-link-more {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  /* Populaire Sectie (Precies 6) */
  .section-popular {
    padding-top: 4rem;
    padding-bottom: 2rem;
  }

  .popular-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .popular-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .popular-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .popular-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .popular-card:hover {
    border-color: var(--color-primary-border);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .popular-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .popular-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .popular-badge-pill {
    font-size: 0.6875rem;
    font-weight: 600;
    background-color: var(--bg-subtle);
    color: var(--text-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .popular-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .popular-card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .popular-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .popular-card-btn {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .arrow-icon {
    color: var(--text-subtle);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .popular-card:hover .arrow-icon {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  /* Popular Footer CTA */
  .popular-footer-cta {
    margin-top: 2rem;
    padding: 1.5rem;
