---
// src/pages/categorie/vergoedingen.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CALCULATORS, CATEGORIES } from '../../data/calculators';

const category = CATEGORIES.vergoedingen;
const calculators = CALCULATORS.filter(c => c.category === 'vergoedingen');

const breadcrumbs = [
  { label: category.title }
];
---

<BaseLayout
  title={`${category.title} berekenen - Rekentools`}
  description={category.description}
>
  <div class="container page-container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="category-header">
      <span class="badge badge-primary">Categorie</span>
      <h1 class="category-title">{category.title}</h1>
      <p class="category-intro">{category.description}</p>
    </header>

    <div class="category-grid">
      {calculators.map((c) => (
        <a href={`/${c.slug}/`} class="calc-hub-card">
          <div class="calc-hub-header">
            <span class="calc-hub-category">{c.categoryTitle}</span>
            <svg class="calc-hub-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
          <h2 class="calc-hub-title">{c.title}</h2>
          <p class="calc-hub-desc">{c.description}</p>
          <div class="calc-hub-footer">
            <span class="calc-hub-cta">Start berekening &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .category-header {
    margin-bottom: 2.5rem;
    max-width: 760px;
  }

  .category-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
  }

  @media (min-width: 640px) {
    .category-title {
      font-size: 2.25rem;
    }
  }

  .category-intro {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .category-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .calc-hub-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .calc-hub-card:hover {
    border-color: var(--color-primary-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .calc-hub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .calc-hub-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .calc-hub-arrow {
    color: var(--text-subtle);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .calc-hub-card:hover .calc-hub-arrow {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  .calc-hub-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .calc-hub-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .calc-hub-footer {
    display: flex;
    align-items: center;
  }

  .calc-hub-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
