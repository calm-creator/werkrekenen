---
// src/pages/weekloon-berekenen.astro
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import WeekloonCalculator from '../components/calculators/WeekloonCalculator.astro';
import { getCalculatorBySlug } from '../data/calculators';
import { DUTCH_RATES } from '../data/dutchRates';

const meta = getCalculatorBySlug('weekloon-berekenen')!;

const faqItems = [
  {
    question: 'Hoe bereken ik mijn bruto weekloon vanuit mijn uurloon?',
    answer: 'Je berekent je bruto weekloon door je bruto uurloon te vermenigvuldigen met het aantal uren dat je per week werkt. Bijvoorbeeld: € 20,00 per uur bij een 40-urige werkweek is 40 × € 20,00 = € 800,00 bruto per week.'
  },
  {
    question: 'Hoe reken ik mijn maandsalaris om naar een weeksalaris?',
    answer: 'Vermenigvuldig je bruto maandsalaris met 12 maanden om je jaarsalaris te berekenen, en deel dat bedrag vervolgens door 52 weken. De formule luidt: (Maandloon × 12) ÷ 52 = Weekloon.'
  },
  {
    question: 'Waarom mag je een maandsalaris niet simpelweg door 4 delen?',
    answer: 'Een kalenderjaar telt 52 weken en 12 maanden. Gemiddeld telt een maand dus 4,3333 weken (52 ÷ 12). Deel je jouw maandloon door 4, dan overschat je jouw werkelijke weekloon met ruim 8,3%.'
  },
  {
    question: 'Wat is het verschil tussen een weekloon en een 4-wekenloon?',
    answer: 'Een weekloon ontvang je wekelijks (52 uitbetalingen per jaar). Een 4-wekenloon (gebruikelijk in de uitzendsector, bouw en transport) dekt precies 4 weken en wordt 13 keer per jaar uitbetaald. Eén periode van 4 weken is exact 4 keer je weekloon.'
  },
  {
    question: 'Hoeveel weken zitten er gemiddeld in een maand?',
    answer: 'Een gemiddelde kalendermaand telt 52 ÷ 12 = 4,3333 weken. Alleen februari telt in een gewoon jaar precies 4 weken (28 dagen). De overige maanden tellen 30 of 31 dagen (4,29 tot 4,43 weken).'
  },
  {
    question: 'Zit vakantiegeld al inbegrepen in het bruto weekloon?',
    answer: 'Nee. Tenzij je een all-in uurloon of all-in weekloon hebt (zoals vaak bij vakantiewerk of flexibele studentenbanen), is het berekende weekloon het vaste basisloon. De wettelijke 8% vakantiebijslag wordt maandelijks gereserveerd en meestal in mei uitgekeerd.'
  },
  {
    question: 'Hoeveel netto houd ik over van mijn bruto weekloon?',
    answer: 'Wat je netto overhoudt hangt af van je schijventarief in box 1, de toepasselijke loonheffingskorting (algemene heffingskorting en arbeidskorting) en eventuele pensioenpremies. Als vuistregel blijft bij modale inkomens zo\'n 70% tot 80% van het bruto weekloon netto over.'
  },
  {
    question: 'Waarom betalen uitzendbureaus vaak per week of per 4 weken?',
    answer: 'Uitzendkrachten werken regelmatig met wisselende uren en flexibele roosters. Een wekelijkse of vierwekelijkse cyclus (13 periodes) sluit nauwkeurig aan op urenbriefjes zonder de schommelende lengte van kalendermaanden.'
  },
  {
    question: 'Hoe bereken ik mijn weekloon bij een parttime baan?',
    answer: 'Bij parttime werken vermenigvuldig je jouw uurloon met je contractuele uren per week (bijvoorbeeld 24, 28 of 32 uur). Werk je vanuit een parttime maandsalaris, dan gebruik je dezelfde formule: (Parttime maandloon × 12) ÷ 52.'
  },
  {
    question: 'Tellen overuren en onregelmatigheidstoeslagen mee in het weekloon?',
    answer: 'Nee, het standaard weekloon betreft uitsluitend je vaste contracturen tegen je basisuurloon. Overuren, overwerktoeslagen en ploegentoeslagen worden bovenop je vaste weekloon uitbetaald op basis van gewerkte declaraties.'
  }
];
---

<CalculatorLayout
  calculator={meta}
  faqItems={faqItems}
  applicableYear={DUTCH_RATES.year}
  officialSource="Ministerie van SZW & Belastingdienst"
>
  <WeekloonCalculator slot="calculator" />

  <div slot="explanation">
    <h2>Wat is een bruto weekloon en hoe bereken je dit?</h2>
    <p>
      Het <strong>bruto weekloon</strong> is het salaris dat je als werknemer verdient voor één werkweek van zeven dagen, vóór inhouding van loonbelasting, premies volksverzekeringen en pensioenafdrachten. In Nederland zijn de meeste vaste banen gebaseerd op een maandsalaris, maar in sectoren zoals de uitzendbranche, bouw, transport en horeca wordt regelmatig gerekend met een wekelijkse of vierwekelijkse uitbetaling.
    </p>
    <p>
      Met onze calculator voor <strong>weekloon berekenen</strong> reken je eenvoudig om tussen uurloon, weekloon en maandsalaris. Wil je nagaan wat je per uur verdient? Gebruik dan onze handige module voor <a href="/uurloon-berekenen/">uurloon berekenen</a> of vergelijk je vaste inkomen via <a href="/uurloon-naar-maandloon-berekenen/">uurloon naar maandloon berekenen</a>.
    </p>

    <div class="callout callout-info">
      <strong>De twee officiële rekenmethodes voor weekloon:</strong><br />
      <code>1. Vanuit uurloon: Weekloon = Uurloon × Wekelijkse arbeidsuren</code><br />
      <code>2. Vanuit maandloon: Weekloon = (Maandsalaris × 12) ÷ 52 weken</code><br /><br />
      <em>Voorbeeld 1:</em> Bij een uurloon van € 20,00 en een werkweek van 40 uur bedraagt je weekloon: <code>40 × € 20,00 = € 800,00 bruto per week</code>.<br />
      <em>Voorbeeld 2:</em> Bij een maandsalaris van € 3.500 bedraagt je jaarsalaris € 42.000. Je weekloon is: <code>€ 42.000 ÷ 52 = € 807,69 bruto per week</code>.
    </div>

    <h2>Waarom een maandloon niet gelijk is aan 4 weken</h2>
    <p>
      Een veelgemaakte denkfout bij het <strong>salaris per week berekenen</strong> is het maandsalaris simpelweg delen door 4. Een kalenderjaar telt 52 weken, maar slechts 12 maanden. Een gemiddelde kalendermaand telt daardoor geen 4 weken, maar precies <strong>4,3333 weken</strong> (52 gedeeld door 12).
    </p>
    <p>
      Als je een maandsalaris van € 3.000 deelt door 4, kom je uit op € 750 per week. Dit is echter onjuist: het werkelijke weekloon bedraagt <code>(€ 3.000 × 12) ÷ 52 = € 692,31</code>. Het verschil bedraagt ruim 8,3%. Reken daarom altijd om via het jaarloon om scheve vergelijkingen te voorkomen. Zie ook onze rekentool voor <a href="/maandloon-naar-uurloon-berekenen/">maandloon naar uurloon berekenen</a>.
    </p>

    <h2>Weekloon vergelijken per wekelijkse arbeidsduur</h2>
    <p>
      In Nederlandse collectieve arbeidsovereenkomsten (cao's) varieert een fulltime werkweek veelal tussen de 36, 38 en 40 uur. Daarnaast werkt een groot deel van de Nederlandse beroepsbevolking in deeltijd (bijvoorbeeld 32 of 24 uur). In onderstaande tabel zie je het bruto weekloon bij verschillende werkweken en voorbeeldlonen.
    </p>

    <div class="table-container" tabindex="0" role="region" aria-label="Tabel: Bruto weekloon per wekelijkse arbeidsduur en uurloon">
      <table class="table-wide">
        <thead>
          <tr>
            <th>Werkweek</th>
            <th>Uurloon € 16,00</th>
            <th>Uurloon € 20,00</th>
            <th>Uurloon € 24,00</th>
            <th>Maandequivalent (bij € 20/u)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>24 uur</strong> (Parttime)</td>
            <td>€ 384,00</td>
            <td>€ 480,00</td>
            <td>€ 576,00</td>
            <td>€ 2.080,00 per maand</td>
          </tr>
          <tr>
            <td><strong>32 uur</strong> (4 dagen)</td>
            <td>€ 512,00</td>
            <td>€ 640,00</td>
            <td>€ 768,00</td>
            <td>€ 2.773,33 per maand</td>
          </tr>
          <tr>
            <td><strong>36 uur</strong> (Fulltime cao)</td>
            <td>€ 576,00</td>
            <td>€ 720,00</td>
            <td>€ 864,00</td>
            <td>€ 3.120,00 per maand</td>
          </tr>
          <tr>
            <td><strong>38 uur</strong> (Fulltime cao)</td>
            <td>€ 608,00</td>
            <td>€ 760,00</td>
            <td>€ 912,00</td>
            <td>€ 3.293,33 per maand</td>
          </tr>
          <tr>
            <td><strong>40 uur</strong> (Standaard fulltime)</td>
            <td>€ 640,00</td>
            <td>€ 800,00</td>
            <td>€ 960,00</td>
            <td>€ 3.466,67 per maand</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>Het verschil tussen weekloon en 4-wekenloon</h2>
    <p>
      Veel uitzendorganisaties en grote werkgevers in de logistiek en detailhandel hanteren een <strong>vierwekelijkse verloning</strong>. Dit betekent dat het jaar is opgedeeld in 13 periodes van 4 weken (13 × 4 = 52 weken).
    </p>
    <ul>
      <li><strong>Weekloon:</strong> Wordt 52 keer per jaar uitbetaald op een vaste dag (bijvoorbeeld elke donderdag of vrijdag).</li>
      <li><strong>4-wekenloon:</strong> Wordt 13 keer per jaar uitbetaald en bedraagt exact 4 keer je bruto weekloon: <code>4-wekenloon = Weekloon × 4</code>.</li>
      <li><strong>Maandloon:</strong> Wordt 12 keer per jaar uitbetaald rond de 25e van elke maand.</li>
    </ul>

    <h2>Bruto weekloon versus netto besteedbaar inkomen</h2>
    <p>
      Het berekende weekloon is altijd een <strong>bruto bedrag</strong>. Wat je uiteindelijk op je bankrekening gestort krijgt (het netto weekloon), is afhankelijk van wettelijke inhoudingen door je werkgever:
    </p>
    <ul>
      <li><strong>Loonheffing:</strong> De gecombineerde inhouding van loonbelasting en premies volksverzekeringen (AOW, Anw, Wlz).</li>
      <li><strong>Heffingskortingen:</strong> De algemene heffingskorting en de arbeidskorting verminderen de in te houden belasting. Zorg dat je de loonheffingskorting bij slechts één werkgever tegelijk aanzet.</li>
      <li><strong>Pensioenpremie:</strong> Veel cao's kennen een verplichte werknemersbijdrage aan een bedrijfstakpensioenfonds, die bruto van je salaris wordt ingehouden.</li>
    </ul>

    <h2>Invloed van vakantiegeld, overuren en toeslagen</h2>
    <p>
      In Nederland heeft iedere werknemer op grond van de Wet minimumloon en minimumvakantiebijslag (WML) recht op minimaal <strong>8% vakantiebijslag</strong> over het bruto jaarsalaris. Bereken je vakantietoeslag via onze pagina voor <a href="/vakantiegeld-berekenen/">vakantiegeld berekenen</a>.
    </p>
    <p>
      Werk je regelmatig extra uren of op onregelmatige tijden? Dan worden overuren en toeslagen (zoals avond-, nacht- of weekendtoeslag) apart bovenop je vaste weekloon verrekend. Controleer je contractsituatie ook via onze calculator voor <a href="/parttime-salaris-berekenen/">parttime salaris berekenen</a>.
    </p>

    <h2>Drie praktijkvoorbeelden van weekloon berekenen</h2>

    <div class="callout callout-info">
      <h3>Voorbeeld 1: Fulltime horecamedewerker (38 uur per week)</h3>
      <p>
        Kevin werkt 38 uur per week in een hotel tegen een bruto uurloon van € 15,50:
      </p>
      <ul>
        <li><strong>Bruto weekloon:</strong> 38 uur × € 15,50 = <strong>€ 589,00 per week</strong>.</li>
        <li><strong>Bruto 4-wekenloon:</strong> € 589,00 × 4 = € 2.356,00 per periode.</li>
        <li><strong>Maandequivalent:</strong> (€ 589,00 × 52) ÷ 12 = € 2.552,33 bruto per maand.</li>
      </ul>
    </div>

    <div class="callout callout-info">
      <h3>Voorbeeld 2: Kantoormedewerker met vast maandsalaris (36 uur per week)</h3>
      <p>
        Fatima verdient € 3.800 bruto per maand bij een 36-urige werkweek volgens de gemeente-cao:
      </p>
      <ul>
        <li><strong>Bruto jaarsalaris:</strong> € 3.800 × 12 = € 45.600 per jaar.</li>
        <li><strong>Bruto weekloon:</strong> € 45.600 ÷ 52 weken = <strong>€ 876,92 per week</strong>.</li>
        <li><strong>Afgeleid uurloon:</strong> € 876,92 ÷ 36 uur = € 24,36 per uur.</li>
      </ul>
    </div>

    <div class="callout callout-info">
      <h3>Voorbeeld 3: Parttimer in de zorg (28 uur per week)</h3>
      <p>
        Sander werkt 28 uur per week als verzorgende tegen een uurloon van € 19,25:
      </p>
      <ul>
        <li><strong>Bruto weekloon:</strong> 28 uur × € 19,25 = <strong>€ 539,00 per week</strong>.</li>
        <li><strong>Bruto maandsalaris:</strong> (€ 539,00 × 52) ÷ 12 = € 2.335,67 per maand.</li>
        <li><strong>Inclusief 8% vakantiegeld:</strong> € 2.335,67 × 1,08 = € 2.522,52 per maand.</li>
      </ul>
    </div>

    <h2>Veelgemaakte fouten bij het omrekenen van weekloon</h2>
    <ol>
      <li><strong>Delen door 4 in plaats van de 52-wekenregel:</strong> Reken altijd via het jaarsalaris (vermenigvuldigen met 12 en delen door 52) voor een betrouwbaar resultaat.</li>
      <li><strong>Vakantiegeld dubbel tellen of vergeten:</strong> Bepaal vooraf of een salarisaanbod inclusief of exclusief 8% vakantiegeld is geformuleerd.</li>
      <li><strong>Verwarring tussen weekloon en 4-wekenloon:</strong> Let goed op of een vacature spreekt over een weekbedrag (52x per jaar) of een 4-wekenbedrag (13x per jaar).</li>
      <li><strong>Vaste dagen koppelen aan gewerkte dagen:</strong> Bepaal met onze tool voor <a href="/werkdagen-berekenen/">werkdagen berekenen</a> het aantal feitelijke werkdagen in een kalenderperiode.</li>
    </ol>
  </div>
</CalculatorLayout>
